{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Debug Connect Color",
            "request": "launch",
            "mainClass": "com.connectcolor.App",
            "projectName": "app",
            "preLaunchTask": "Compile Connect Color",
            "console": "integratedTerminal",
            "classPaths": [
                "${env:USERPROFILE}\\.connect-color-build\\com.app\\app\\classes"
            ],
            "vmArgs": "--module-path \"${env:USERPROFILE}\\.m2\\repository\\org\\openjfx\\javafx-base\\13\\javafx-base-13-win.jar;${env:USERPROFILE}\\.m2\\repository\\org\\openjfx\\javafx-controls\\13\\javafx-controls-13-win.jar;${env:USERPROFILE}\\.m2\\repository\\org\\openjfx\\javafx-fxml\\13\\javafx-fxml-13-win.jar;${env:USERPROFILE}\\.m2\\repository\\org\\openjfx\\javafx-graphics\\13\\javafx-graphics-13-win.jar\" --add-modules javafx.controls,javafx.fxml --enable-native-access=javafx.graphics"
        }
    ]
}
